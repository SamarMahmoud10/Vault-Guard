# --- POSTGRES DATABASE CONFIGURATION ---
POSTGRES_USER=vault_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=vault_guard_db

# --- SQLALCHEMY DATABASE CONNECTION URL ---
DATABASE_URL=postgresql://vault_admin:your_secure_password_here@db:5432/vault_guard_db

# --- VAULT-GUARD API SECURITY KEY ---
VAULT_GUARD_API_KEY=your_secret_api_token_here

# --- THIRD-PARTY INTEGRATION WEBHOOKS ---
DISCORD_WEBHOOK_URL=https://discord.com
